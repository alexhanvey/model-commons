# Copy to .env and fill in local values. Never commit .env.

# Vast.ai API key with instance-management permission.
VAST_API_KEY=

# Optional: Hugging Face token for gated models/datasets.
HF_TOKEN=

# API
API_PORT=8000
WEB_PORT=3000
INFERENCE_PORT=8001
COMMUNITY_LLM_ENVIRONMENT=local
COMMUNITY_LLM_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Postgres
POSTGRES_USER=community
POSTGRES_PASSWORD=community
POSTGRES_DB=community_llm
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://community:community@localhost:5433/community_llm

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# S3-compatible storage (RustFS locally, Cloudflare R2 in production).
# These credentials are also used by the local RustFS container.
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_ARTIFACTS=artifacts
S3_BUCKET_DATASETS=datasets
S3_BUCKET_MODELS=models
S3_BUCKET_LOGS=logs
